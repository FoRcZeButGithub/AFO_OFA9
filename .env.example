# =============================================================================
# TripSure AI (ทริปชัวร์) Environment Variables Template
# All features will work with realistic fallback mock data if keys are left blank!
# =============================================================================

# 1. Google Gemini AI SDK (@google/genai)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Database & Auth (Optional - falls back to reactive LocalStorage state)
# Get keys at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Thai Meteorological Department (TMD) API
# Get your token at: https://data.tmd.go.th/
# Note: If left empty, system automatically uses Open-Meteo free real-time weather API!
TMD_API_TOKEN=your_tmd_api_token_here

# 4. Stripe Simulation / Live Keys (Optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder

# 5. App Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
